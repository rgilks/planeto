{
  "name": "planeto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "preview-build": "NEXT_PREVIEW_BUILD=true next build",
    "start": "next start",
    "lint": "next lint",
    "check": "prettier --write . && next lint --fix --no-cache && npx tsc --noEmit && npx playwright test --reporter=list",
    "deps": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && npm install",
    "nuke": "rm -rf node_modules package-lock.json .next .next-validation && npm install",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --watch"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "better-sqlite3": "^11.9.1",
    "immer": "^10.1.1",
    "next": "15.3.2",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.176.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.4",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "eslint-config-prettier": "^10.1.1",
    "npm-check-updates": "^17.1.16",
    "playwright": "^1.51.1",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.30.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
